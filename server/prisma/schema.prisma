generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Administrator {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String?
  role          String      @default("ADMIN")
  isActive      Boolean     @default(true)
  emailVerified Boolean     @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  auditLogs     AuditLog[]
  sessions      Session[]
  mfaSecret     MfaSecret?
  backupCodes   BackupCode[]
  securityEvents SecurityEvent[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([isActive])
  @@index([role])
}

model WebsiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}

model PersonalProfile {
  id            String      @id @default(cuid())
  fullName      String
  title         String
  bio           String?
  location      String?
  email         String?
  phone         String?
  whatsapp      String?
  linkedin      String?
  github        String?
  avatarImageId String?
  isActive      Boolean     @default(true)
  updatedBy     String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())
  avatar        MediaAsset? @relation(fields: [avatarImageId], references: [id])

  @@index([isActive])
}

model Project {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  label         String?
  summary       String?
  detail        String?
  repoUrl       String?
  demoUrl       String?
  status        ContentStatus @default(DRAFT)
  featured      Boolean     @default(false)
  sortOrder     Int         @default(0)
  mediaAssetId  String?
  updatedBy     String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
}

model Education {
  id           String      @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  status       ContentStatus @default(DRAFT)
  sortOrder    Int         @default(0)
  updatedBy    String?
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  @@index([status])
  @@index([sortOrder])
}

model ProfessionalExperience {
  id           String      @id @default(cuid())
  company      String
  role         String
  location     String?
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean     @default(false)
  description  String?
  status       ContentStatus @default(DRAFT)
  sortOrder    Int         @default(0)
  updatedBy    String?
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  @@index([status])
  @@index([sortOrder])
}

model LeadershipPosition {
  id          String      @id @default(cuid())
  organization String
  position    String
  startDate   DateTime?
  endDate     DateTime?
  description String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int         @default(0)
  updatedBy   String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([sortOrder])
}

model Certification {
  id          String      @id @default(cuid())
  title       String
  issuer      String
  date        DateTime?
  description String?
  imageId     String?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int         @default(0)
  updatedBy   String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  mediaAsset  MediaAsset? @relation(fields: [imageId], references: [id])

  @@index([status])
  @@index([sortOrder])
}

model Skill {
  id          String   @id @default(cuid())
  category    String
  name        String
  proficiency Int?     @default(0)
  sortOrder   Int      @default(0)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([sortOrder])
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  originalName String?
  mimeType    String?
  size        Int?
  url         String
  alt         String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  projects    Project[]
  certifications Certification[]
  profiles    PersonalProfile[]

  @@index([filename])
  @@index([uploadedBy])
  @@index([mimeType])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String?
  message     String
  status      ContactStatus @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     Administrator? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  sid          String   @unique
  data         String
  expiresAt    DateTime
  adminId      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  admin        Administrator? @relation(fields: [adminId], references: [id])

  @@index([sid])
  @@index([expiresAt])
  @@index([adminId])
}

model MfaSecret {
  id        String   @id @default(cuid())
  adminId   String   @unique
  secret    String   // base32-encoded TOTP secret
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     Administrator @relation(fields: [adminId], references: [id])

  @@index([adminId])
}

model BackupCode {
  id        String   @id @default(cuid())
  adminId   String
  codeHash  String   // bcrypt hash of the 8-char backup code
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usedAt    DateTime?
  admin     Administrator @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([used])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  adminId   String?
  action    String   // LOGIN, LOGIN_FAILED, MFA_VERIFY, MFA_SETUP, LOGOUT, PASSWORD_RESET, RECOVERY, SESSION_REVOKED, CSRF_VIOLATION, RATE_LIMIT_EXCEEDED
  entity    String
  entityId  String?
  ipAddress String
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Administrator? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([ipAddress])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  adminId   String
  tokenHash String   // bcrypt hash of the reset token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  admin     Administrator @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([tokenHash])
  @@index([expiresAt])
}
