# Portfolio CMS — Environment variables
# Copy this file to .env and populate required values before running.
# NEVER commit .env to version control.

# Required: Neon PostgreSQL connection string (sslmode=require)
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Required: Express session signing secret (min 32 chars)
SESSION_SECRET="replace-with-a-strong-32-char-secret"

# Required: Cookie signing secret (min 32 chars)
COOKIE_SECRET="replace-with-a-strong-32-char-secret"

# Required: AES-256-GCM encryption key for MFA secrets at rest (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-character-encryption-key"

# Required: Single owner credentials (one-time provisioning only)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-strong-password-min-12-chars"
ADMIN_NAME="Portfolio Owner"

# Environment
NODE_ENV="development"
PORT="4000"
BASE_URL="http://localhost:4000"

# CORS — restrict to your domain in production
CORS_ORIGIN="http://localhost:4000"
