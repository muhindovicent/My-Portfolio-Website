# Portfolio CMS — Environment variables
# Copy this file to .env and populate required values before running.

# Required: Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Required: JWT signing secret (min 32 chars)
JWT_SECRET="replace-with-a-strong-32-char-secret"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Required: Default administrator credentials (one-time setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"

# Required: Cookie signing secret (min 32 chars)
COOKIE_SECRET="replace-with-a-strong-32-char-secret"

# Required: Express session signing secret (min 32 chars)
SESSION_SECRET="replace-with-a-strong-32-char-secret"

# Environment
NODE_ENV="development"
PORT="4000"
BASE_URL="http://localhost:4000"

# CORS
CORS_ORIGIN="http://localhost:4000"
